# Rename this file to ".env" and fill in real values.
# NEVER commit the real .env file to version control.

# Get a free key at https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Django settings
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
